[Unit]
Description=Proteus event-driven rotation daemon
Documentation=https://github.com/Kit3713/Proteus
# Roadmap Milestone 4c. The dispatcher script under
# dist/networkmanager/dispatcher.d/01-proteus keeps its existing role
# (per-event proteus rotate-if-needed calls); this unit is the
# long-running counterpart that subscribes to NM StateChanged,
# RTNETLINK link-flap, nl80211 reg-domain, and the captive-portal
# poller. Opt-in via [events] enabled = true in /etc/proteus/config.toml.
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/proteus events run
Restart=on-failure
RestartSec=5s
User=root

# Hardening (see systemd.exec(5)). Mirrors proteus-rotate.service plus
# the strict-protect bits that suit a long-running daemon.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Capabilities — the four sources need:
# - CAP_NET_ADMIN: bind RTNETLINK + genetlink multicast groups (link-flap,
#   reg-domain). Sources gracefully degrade to no-op when missing.
# - CAP_NET_RAW:   captive-portal sampler can shell out to a raw probe in
#   the existing path; future-proof for the active-probe variant.
# - CAP_NET_BIND_SERVICE: paranoid future-proofing, no current binder.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Read-write access to the small set of paths the rotation handler
# touches. /etc/proteus is read-only on purpose: the daemon never
# rewrites config; /var/lib/proteus carries state.json.
ReadWritePaths=/var/lib/proteus
ReadOnlyPaths=/etc/proteus

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=proteus-events

[Install]
WantedBy=multi-user.target
