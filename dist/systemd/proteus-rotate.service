[Unit]
Description=Proteus scheduled MAC rotation
After=NetworkManager.service network-online.target
Wants=network-online.target NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/proteus rotate --yes
User=root

# Hardening (see systemd.exec(5)). Issue #228: parity with proteus-events.service.
# `rotate` only writes to /var/lib/proteus (state.json) and talks to NM/hostnamed
# over DBus, so strict ProtectSystem fits without weakening the workload.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

# CAP_NET_ADMIN: nftables + sysctl writes for L2/L3 rotation.
# CAP_NET_RAW:   ICMP probe fallback.
# CAP_NET_BIND_SERVICE: bind to privileged ports if probe targets require it.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Read-write access to the state directory only — rotate persists captured
# originals + per-iface rotation records to /var/lib/proteus/state.json.
# /etc/proteus is read-only on purpose: rotate never rewrites config.
ReadWritePaths=/var/lib/proteus
ReadOnlyPaths=/etc/proteus

SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @cpu-emulation @debug @raw-io @reboot @swap @mount @module @clock
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=proteus
