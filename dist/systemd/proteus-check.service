[Unit]
Description=Proteus probe-driven rotation check
After=NetworkManager.service network-online.target
Wants=network-online.target NetworkManager.service

[Service]
Type=oneshot
# The probe-conditional rotation logic lands in phase C. Until then this
# unit invokes `proteus rotate --if-needed --yes`; the binary will treat
# `--if-needed` as a no-op until the probe quorum + cooldown logic is wired
# up, so this is safe to ship now.
ExecStart=/usr/local/bin/proteus rotate --if-needed --yes
User=root

# Hardening (see systemd.exec(5)).
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# CAP_NET_ADMIN: nftables + sysctl writes for L2/L3 rotation.
# CAP_NET_RAW:   ICMP probe fallback (phase C).
# CAP_NET_BIND_SERVICE: bind to privileged ports if probe targets require it.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service

StandardOutput=journal
StandardError=journal
SyslogIdentifier=proteus
