[Unit]
Description=Proteus rotate on resume from suspend
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/proteus rotate --yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proteus-resume
# Hardening matches proteus-rotate.service (see systemd.exec(5)).
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
# CAP_NET_ADMIN: nftables + sysctl writes for L2/L3 rotation.
# CAP_NET_RAW:   ICMP probe fallback (phase C).
# CAP_NET_BIND_SERVICE: bind to privileged ports if probe targets require it.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
