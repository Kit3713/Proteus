#!/bin/bash
# managed by proteus — NetworkManager dispatcher hook for event-driven rotation
#
# Drop into /etc/NetworkManager/dispatcher.d/ (or /usr/lib/NetworkManager/
# dispatcher.d/). Owner root, mode 0755.
#
# NM invokes this on every connection state change with two args:
#   $1 = interface name
#   $2 = action (up|down|pre-up|pre-down|vpn-up|vpn-down|hostname|
#                dhcp4-change|dhcp6-change|connectivity-change)
#
# Newer NM also exports NM_DISPATCHER_ACTION; we prefer that when set.
#
# Architectural note: there is no daemon. Each event triggers a short-lived
# CLI invocation. Honors the "no daemon" invariant from docs/PLAN.md.
# See `proteus wiki rotation` for the full rationale.
#
# All log lines go to journald via `logger -t proteus-dispatcher`.
# We always exit 0 — NM treats nonzero as a script failure.
#
# Security: NM dispatcher runs as root. We MUST NOT trust $PATH for binary
# resolution — any user-writable directory ahead of /usr/bin in PATH would
# become a root code-execution surface. We pin to absolute paths and reset
# PATH to a minimal, root-only set before any helper invocation.

set -u

# Minimal, root-owned PATH. Resets whatever NM inherited from its parent.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

iface="${1:-}"
action="${NM_DISPATCHER_ACTION:-${2:-}}"

log() {
    logger -t proteus-dispatcher -- "$*" 2>/dev/null || true
}

# Resolve the proteus binary by absolute path only. Distro packages land
# at /usr/bin/proteus; install.sh lands at /usr/local/bin/proteus. Both
# directories are root-writable only, so the lookup itself can't be
# subverted by an unprivileged user the way a $PATH search could.
proteus_bin=""
for candidate in /usr/bin/proteus /usr/local/bin/proteus; do
    if [ -x "$candidate" ]; then
        proteus_bin="$candidate"
        break
    fi
done
if [ -z "$proteus_bin" ]; then
    log "proteus binary not found at /usr/bin/proteus or /usr/local/bin/proteus; skipping (iface=$iface action=$action)"
    exit 0
fi

# Connectivity state (only meaningful for action=connectivity-change).
# NM exports CONNECTIVITY_STATE in newer versions.
conn_state="${CONNECTIVITY_STATE:-}"

case "$action" in
    up)
        # Interface came up. Roadmap Milestone 1 (issue #206-C): the
        # cooldown decision now lives behind the typed
        # `proteus rotate-if-needed` subcommand, which returns a
        # structured result as one stdout line plus a deterministic
        # exit code:
        #
        #   rotated <iface>: <new-mac>          (success: rotation happened)
        #   skipped <iface>: cooldown <secs>s   (success: cooldown not yet elapsed)
        #   skipped <iface>: no factory MAC ... (success: operator action needed)
        #   unavailable <iface>: ...            (rc=70: backend reports unavailable)
        #
        # The previous shell `sed`-grep on `proteus current --json` is
        # gone — fragile against JSON-shape changes and any nested key
        # named `last_rotated` would have shadowed the intended one.
        cooldown_secs=60
        # Roadmap Milestone 3: NM exports the SSID via CONNECTION_ID
        # (the connection profile's id, which on Wi-Fi defaults to
        # the SSID). Pass it through so rotate-if-needed can resolve
        # `[per_ssid."<ssid>"]` overrides (pin_mac, rotate_interval).
        ssid_arg=""
        if [ -n "${CONNECTION_ID:-}" ]; then
            ssid_arg="--ssid"
        fi
        if [ -n "$ssid_arg" ]; then
            out="$("$proteus_bin" rotate-if-needed --iface "$iface" --cooldown "$cooldown_secs" "$ssid_arg" "$CONNECTION_ID" --yes 2>/dev/null)"
        else
            out="$("$proteus_bin" rotate-if-needed --iface "$iface" --cooldown "$cooldown_secs" --yes 2>/dev/null)"
        fi
        rc=$?
        if [ "$rc" -eq 0 ]; then
            log "iface=$iface up: $out"
        elif [ "$rc" -eq 70 ]; then
            # SYSTEM_NOT_SUPPORTED: backend reports unavailable. Log
            # but don't fail — the dispatcher always exits 0.
            log "iface=$iface up: backend unavailable (rc=70): $out"
        else
            log "iface=$iface up: rotate-if-needed exited rc=$rc: $out"
        fi
        ;;

    connectivity-change)
        # Don't rotate behind a portal — that just loops. When connectivity
        # is restored ('full'), Phase C's --if-needed predicate will decide
        # whether to opportunistically rotate. For now we just log.
        log "connectivity-change state=${conn_state:-unknown} iface=$iface (no action)"
        ;;

    down|pre-up|pre-down|vpn-up|vpn-down|dhcp4-change|dhcp6-change|hostname)
        log "event action=$action iface=$iface (no action)"
        ;;

    *)
        log "event action=${action:-?} iface=$iface (unhandled, no action)"
        ;;
esac

exit 0
