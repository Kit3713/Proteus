#!/bin/bash
# managed by proteus — NetworkManager dispatcher hook for event-driven rotation
#
# Drop into /etc/NetworkManager/dispatcher.d/ (or /usr/lib/NetworkManager/
# dispatcher.d/). Owner root, mode 0755.
#
# NM invokes this on every connection state change with two args:
#   $1 = interface name
#   $2 = action (up|down|pre-up|pre-down|vpn-up|vpn-down|hostname|
#                dhcp4-change|dhcp6-change|connectivity-change)
#
# Newer NM also exports NM_DISPATCHER_ACTION; we prefer that when set.
#
# Architectural note: there is no daemon. Each event triggers a short-lived
# CLI invocation. Honors the "no daemon" invariant from docs/PLAN.md.
# See `proteus wiki rotation` for the full rationale.
#
# All log lines go to journald via `logger -t proteus-dispatcher`.
# We always exit 0 — NM treats nonzero as a script failure.
#
# Security: NM dispatcher runs as root. We MUST NOT trust $PATH for binary
# resolution — any user-writable directory ahead of /usr/bin in PATH would
# become a root code-execution surface. We pin to absolute paths and reset
# PATH to a minimal, root-only set before any helper invocation.

set -u

# Minimal, root-owned PATH. Resets whatever NM inherited from its parent.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

iface="${1:-}"
action="${NM_DISPATCHER_ACTION:-${2:-}}"

log() {
    logger -t proteus-dispatcher -- "$*" 2>/dev/null || true
}

# Resolve the proteus binary by absolute path only. Distro packages land
# at /usr/bin/proteus; install.sh lands at /usr/local/bin/proteus. Both
# directories are root-writable only, so the lookup itself can't be
# subverted by an unprivileged user the way a $PATH search could.
proteus_bin=""
for candidate in /usr/bin/proteus /usr/local/bin/proteus; do
    if [ -x "$candidate" ]; then
        proteus_bin="$candidate"
        break
    fi
done
if [ -z "$proteus_bin" ]; then
    log "proteus binary not found at /usr/bin/proteus or /usr/local/bin/proteus; skipping (iface=$iface action=$action)"
    exit 0
fi

# Connectivity state (only meaningful for action=connectivity-change).
# NM exports CONNECTIVITY_STATE in newer versions.
conn_state="${CONNECTIVITY_STATE:-}"

# Issue #225: defense-in-depth validation of NM-exported strings used as
# CLI arguments. NM_DISPATCHER_ACTION ($action), $iface, and
# $CONNECTION_ID are all populated from values that may be attacker-
# controlled (a probe-response SSID or a malicious connection profile
# pushed through NM). Even though clap parses argv (not a shell), we
# still enforce a strict allow-list before invoking proteus so a future
# refactor can't accidentally re-introduce a shell-eval path. Reject
# (don't escape) on failure: the cost of a missed rotation is far less
# than mishandling a hostile string.
#
# Rules:
#   - Length 1..=128 bytes (NM hard-caps SSID at 32 chars but allow some
#     headroom for connection-id which can be longer).
#   - Must be printable ASCII or valid UTF-8 above 0x7f.
#   - No NUL, no control chars (0x00–0x1F or 0x7F).
#   - No leading dash (would be parsed as a flag without `--`).
#   - No shell metacharacters (despite using exec-form, this is the
#     belt-and-suspenders bit).
validate_cli_value() {
    local val="$1"
    local label="$2"
    if [ -z "$val" ]; then
        return 1
    fi
    # GH#362: bash `${#val}` is *character* length, not byte length, and
    # the count depends on the active LC_* locale. Under a UTF-8 locale a
    # 4-byte codepoint counts as 1, so a hostile SSID could smuggle up to
    # ~512 bytes through this 128-cap. Resolve by computing byte length
    # explicitly via `wc -c` after `LC_ALL=C` so the count is locale-
    # invariant. Subtract 0 (printf %s emits no trailing newline; wc -c
    # counts every byte we hand it).
    local _bytelen
    _bytelen="$(LC_ALL=C printf '%s' "$val" | LC_ALL=C wc -c)"
    _bytelen="${_bytelen##* }"  # strip any leading whitespace from BSD wc
    if [ "$_bytelen" -gt 128 ]; then
        log "rejected $label: too long ($_bytelen bytes)"
        return 1
    fi
    # Leading dash means clap would treat it as a flag (mitigated by the
    # `--flag=VALUE` form below, but reject anyway as defense-in-depth).
    case "$val" in
        -*)
            log "rejected $label: leading dash"
            return 1
            ;;
    esac
    # Reject shell metacharacters as a belt-and-suspenders safety net even
    # though we use exec form (no `eval`, no `sh -c`).
    case "$val" in
        *[\\\&\;\|\\\`\$\(\)\<\>\"\']*)
            log "rejected $label: shell metacharacter in value"
            return 1
            ;;
    esac
    # Reject ASCII control characters (incl. NUL, newline, tab, CR, DEL).
    # `tr -d '[:cntrl:]'` is byte-stream-aware (unlike grep, which works
    # line-by-line and would never see embedded \n). We compare BYTE
    # lengths; a hostile string with any cntrl char drops bytes and
    # trips the test. GH#362: `${#var}` is locale-dependent, so use
    # `LC_ALL=C wc -c` for both sides to keep the comparison byte-exact.
    local _stripped _stripped_len
    _stripped="$(LC_ALL=C printf '%s' "$val" | LC_ALL=C tr -d '[:cntrl:]')"
    _stripped_len="$(LC_ALL=C printf '%s' "$_stripped" | LC_ALL=C wc -c)"
    _stripped_len="${_stripped_len##* }"
    if [ "$_bytelen" -ne "$_stripped_len" ]; then
        log "rejected $label: control character in value"
        return 1
    fi
    return 0
}

case "$action" in
    up)
        # Validate $iface before anything else — it ends up as the value
        # of `--iface`. Linux iface names are <=15 bytes and a strict
        # subset of ASCII; the validate fn is plenty.
        if ! validate_cli_value "$iface" "iface"; then
            log "iface=$iface up: rejected — invalid iface string; skipping rotation"
            exit 0
        fi
        # Interface came up. Roadmap Milestone 1 (issue #206-C): the
        # cooldown decision now lives behind the typed
        # `proteus rotate-if-needed` subcommand, which returns a
        # structured result as one stdout line plus a deterministic
        # exit code:
        #
        #   rotated <iface>: <new-mac>          (success: rotation happened)
        #   skipped <iface>: cooldown <secs>s   (success: cooldown not yet elapsed)
        #   skipped <iface>: no factory MAC ... (success: operator action needed)
        #   unavailable <iface>: ...            (rc=70: backend reports unavailable)
        #
        # The previous shell `sed`-grep on `proteus current --json` is
        # gone — fragile against JSON-shape changes and any nested key
        # named `last_rotated` would have shadowed the intended one.
        cooldown_secs=60
        # Roadmap Milestone 3: NM exports the SSID via CONNECTION_ID
        # (the connection profile's id, which on Wi-Fi defaults to
        # the SSID). Pass it through so rotate-if-needed can resolve
        # `[per_ssid."<ssid>"]` overrides (pin_mac, rotate_interval).
        #
        # Issue #225: $CONNECTION_ID is attacker-controlled (an SSID
        # broadcasted by a hostile AP, or a connection profile pushed
        # through nmcli by a malicious tool). Validate it; if it fails,
        # drop the --ssid bit but still rotate (defense-in-depth — do
        # not break the rotation path because of a weird SSID). Use
        # the `--` separator so anything that survives validation but
        # happens to start with a dash still parses as a value.
        pass_ssid=0
        ssid_val=""
        if [ -n "${CONNECTION_ID:-}" ]; then
            if validate_cli_value "$CONNECTION_ID" "connection-id"; then
                pass_ssid=1
                ssid_val="$CONNECTION_ID"
            else
                log "iface=$iface up: dropping CONNECTION_ID; rotating without per-SSID override"
            fi
        fi
        # Capture stderr (issue #254): redirecting to /dev/null hides
        # real failures (binary segfault, missing capabilities, lock
        # contention). Merge into stdout so `out` carries both, and
        # log the combined output via journald.
        #
        # Issue #225: bind every NM-sourced string to its flag with
        # `--flag=VALUE` form. Even though validate_cli_value already
        # rejected a leading dash, the equals form is structurally
        # immune to clap mis-parsing the value as another flag — clap
        # treats `--ssid=foo` as one token, so `foo` cannot ever be
        # confused for a flag. This belt-and-suspenders pairing matches
        # the standing security review note in docs/PLAN.md (#225).
        if [ "$pass_ssid" -eq 1 ]; then
            out="$("$proteus_bin" rotate-if-needed --iface="$iface" --cooldown="$cooldown_secs" --ssid="$ssid_val" --yes 2>&1)"
        else
            out="$("$proteus_bin" rotate-if-needed --iface="$iface" --cooldown="$cooldown_secs" --yes 2>&1)"
        fi
        rc=$?
        if [ "$rc" -eq 0 ]; then
            log "iface=$iface up: $out"
        elif [ "$rc" -eq 70 ]; then
            # SYSTEM_NOT_SUPPORTED: backend reports unavailable. Log
            # but don't fail — the dispatcher always exits 0.
            log "iface=$iface up: backend unavailable (rc=70): $out"
        else
            log "iface=$iface up: rotate-if-needed exited rc=$rc: $out"
        fi
        ;;

    connectivity-change)
        # Don't rotate behind a portal — that just loops. When connectivity
        # is restored ('full'), the --if-needed predicate will decide
        # whether to opportunistically rotate. For now we just log.
        log "connectivity-change state=${conn_state:-unknown} iface=$iface (no action)"
        ;;

    down|pre-up|pre-down|vpn-up|vpn-down|dhcp4-change|dhcp6-change|hostname)
        log "event action=$action iface=$iface (no action)"
        ;;

    *)
        log "event action=${action:-?} iface=$iface (unhandled, no action)"
        ;;
esac

exit 0
